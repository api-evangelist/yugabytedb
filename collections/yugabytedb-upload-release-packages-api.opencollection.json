          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/api/v1/customers/:cUUID/ybdb_release/upload/:rUUID",
            "params": [
              {
                "name": "cUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path"
              },
              {
                "name": "rUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path"
              },
              {
                "name": "request",
                "value": "example-request",
                "type": "query"
              }
            ]
          },
          "docs": "WARNING: This is a preview API that could change: get uploaded release metadata"
        }
      ]
