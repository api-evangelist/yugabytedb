{
  "opencollection": "1.0.0",
  "info": {
    "name": "YugabyteDB Aeon REST Access Keys Platform Replication API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
