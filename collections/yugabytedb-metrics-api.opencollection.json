{
  "opencollection": "1.0.0",
  "info": {
    "name": "YugabyteDB Aeon REST Access Keys Metrics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "YugabyteDB Anywhere Get Prometheus Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/api/v1/prometheus_metrics",
            "params": [
              {
                "name": "request",
                "value": "example-request",
                "type": "query"
              }
            ]
          },
          "docs": "Available since YBA version 2.8.0.0."
        },
        {
          "info": {
            "name": "YugabyteDB Anywhere Get Prometheus Host Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/host-info"
          },
          "docs": "Get the Url for the Prometheus instance of the current YBA"
        }
      ]
    }
  ],
  "bundled": true
}