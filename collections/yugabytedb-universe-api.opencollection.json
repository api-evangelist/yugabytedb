            "params": [
              {
                "name": "cUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path",
                "description": "Customer UUID"
              },
              {
                "name": "uniUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
