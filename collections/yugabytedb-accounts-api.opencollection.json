{
  "opencollection": "1.0.0",
  "info": {
    "name": "YugabyteDB Aeon REST Access Keys Accounts API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "YugabyteDB Aeon List Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/accounts"
          },
          "docs": "Returns a list of YugabyteDB Aeon accounts accessible to the authenticated API key holder. Most users have a single account."
        },
        {
          "info": {
            "name": "YugabyteDB Aeon Get Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path",
                "description": "The unique identifier of the YugabyteDB Aeon account."
              }
            ]
          },
          "docs": "Returns metadata for a specific YugabyteDB Aeon account, including the account ID used to scope project and cluster API calls."
        }
      ]
    }
  ],
  "bundled": true
}