{
  "opencollection": "1.0.0",
  "info": {
    "name": "YugabyteDB Aeon REST Access Keys Extract metadata from remote tarball API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Extract metadata from remote tarball",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "YugabyteDB Anywhere Helper to Extract Release Metadata from a Remote Tarball",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloud.yugabyte.com/api/public/v1/api/v1/customers/:cUUID/ybdb_release/extract_metadata",
            "params": [
              {
                "name": "cUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path"
              },
              {
                "name": "request",
                "value": "example-request",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "WARNING: This is a preview API that could change: start extracting metadata from a remote tgz url"
        },
        {
          "info": {
            "name": "YugabyteDB Anywhere Get the Extract Release Metadata from a Remote Tarball",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.yugabyte.com/api/public/v1/api/v1/customers/:cUUID/ybdb_release/extract_metadata/:rUUID",
            "params": [
              {
                "name": "cUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path"
              },
              {
                "name": "rUUID",
                "value": "046b6c7f-0b8a-43b9-b35d-6489e6daee91",
                "type": "path"
              },
              {
                "name": "request",
                "value": "example-request",
                "type": "query"
              }
            ]
          },
          "docs": "WARNING: This is a preview API that could change: Get extract metadata and its progress."
        }
      ]
    }
  ],
  "bundled": true
}