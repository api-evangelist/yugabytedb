                  "type": "any",
                  "value": "<uuid>",
                  "key": "accountId",
                  "description": "(Required) The unique identifier of the YugabyteDB Aeon account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "projectId",
                  "description": "(Required) The unique identifier of the project within the account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "clusterId",
                  "description": "(Required) The unique identifier of the cluster."
