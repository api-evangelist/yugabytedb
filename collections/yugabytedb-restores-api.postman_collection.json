          "name": "YugabyteDB Aeon Restore from Backup",
          "request": {
            "name": "YugabyteDB Aeon Restore from Backup",
            "description": {
              "content": "Restores the specified cluster from a previously created backup. The restore operation overwrites the current cluster data with the state captured in the backup snapshot.",
              "type": "text/plain"
            },
